---
import { getLangFromUrl, useTranslations, getLocalePath } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
  { href: getLocalePath(lang, "/works"), label: t("nav.works") },
  { href: getLocalePath(lang, "/research"), label: t("nav.research") },
  { href: getLocalePath(lang, "/studio"), label: t("nav.studio") },
  { href: getLocalePath(lang, "/about"), label: t("nav.about") },
  { href: getLocalePath(lang, "/bio"), label: t("nav.bio") },
  { href: getLocalePath(lang, "/contact"), label: t("nav.contact") },
];

const altLang = lang === "en" ? "es" : "en";
const altPath = lang === "en"
  ? `/es${Astro.url.pathname}`
  : Astro.url.pathname.replace(/^\/es/, "") || "/";
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-border-dark light:border-border-light bg-bg-dark/90 light:bg-bg-light/90 backdrop-blur-sm">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-8">

    <!-- Logo + name -->
    <a href={getLocalePath(lang, "/")} class="flex items-center gap-3 shrink-0">
      <img src="/logo.svg" alt="OD" width="28" height="28" class="opacity-90" />
      <span class="font-mono text-sm tracking-[0.20em] text-text-secondary-dark light:text-text-secondary-light uppercase">
        OD
      </span>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden md:flex items-center gap-6">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class="font-mono text-xs tracking-[0.20em] uppercase text-text-muted-dark light:text-text-muted-light hover:text-accent transition-colors"
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Controls -->
    <div class="flex items-center gap-4">
      <!-- Lang switch -->
      <a
        href={altPath}
        class="font-mono text-xs tracking-[0.20em] text-text-muted-dark light:text-text-muted-light hover:text-accent transition-colors"
        aria-label={t("lang.toggle")}
      >
        {t("lang.toggle")}
      </a>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        aria-label={t("theme.toggle")}
        class="w-8 h-8 flex items-center justify-center text-text-muted-dark light:text-text-muted-light hover:text-accent transition-colors"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="hidden">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Hamburger mobile -->
      <button
        id="menu-toggle"
        class="md:hidden w-8 h-8 flex flex-col items-center justify-center gap-1.5"
        aria-label="Menu"
      >
        <span class="w-5 h-px bg-current block"></span>
        <span class="w-5 h-px bg-current block"></span>
        <span class="w-3 h-px bg-current block self-start"></span>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border-dark light:border-border-light">
    <nav class="flex flex-col px-6 py-4 gap-4">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class="font-mono text-xs tracking-[0.20em] uppercase text-text-muted-dark light:text-text-muted-light hover:text-accent transition-colors"
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // Theme
  const html = document.documentElement;
  const stored = localStorage.getItem("theme");
  if (stored === "light") html.classList.add("light");

  const btn = document.getElementById("theme-toggle");
  const iconSun = document.getElementById("icon-sun");
  const iconMoon = document.getElementById("icon-moon");

  function updateIcons() {
    const isLight = html.classList.contains("light");
    iconSun?.classList.toggle("hidden", !isLight);
    iconMoon?.classList.toggle("hidden", isLight);
  }
  updateIcons();

  btn?.addEventListener("click", () => {
    html.classList.toggle("light");
    localStorage.setItem("theme", html.classList.contains("light") ? "light" : "dark");
    updateIcons();
  });

  // Mobile menu
  const menuBtn = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  menuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
</script>
