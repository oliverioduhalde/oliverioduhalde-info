---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLangFromUrl } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const isEs = lang === "es";

// Formspree endpoint — replace with actual ID
const FORMSPREE_ID = "your_formspree_id";
---

<BaseLayout
  title={isEs ? "Contacto — Oliverio Duhalde" : "Contact — Oliverio Duhalde"}
>
  <section class="max-w-7xl mx-auto px-6 pt-20 pb-24">
    <div class="max-w-xl">
      <p class="font-mono text-xs tracking-[0.30em] uppercase text-accent mb-4">
        {isEs ? "Contacto" : "Contact"}
      </p>
      <h1 class="text-4xl md:text-5xl font-sans font-medium tracking-tight text-text-primary-dark light:text-text-primary-light mb-8 leading-tight">
        {isEs ? "Escribime" : "Get in touch"}
      </h1>

      <form
        action={`https://formspree.io/f/${FORMSPREE_ID}`}
        method="POST"
        class="space-y-6"
      >
        <div>
          <label class="block font-mono text-[10px] tracking-[0.25em] uppercase text-text-faint-dark light:text-text-faint-light mb-2">
            {isEs ? "Nombre" : "Name"}
          </label>
          <input
            type="text"
            name="name"
            required
            class="w-full bg-surface-dark light:bg-surface-light border border-border-dark light:border-border-light px-4 py-3 text-sm text-text-primary-dark light:text-text-primary-light focus:outline-none focus:border-accent transition-colors"
          />
        </div>

        <div>
          <label class="block font-mono text-[10px] tracking-[0.25em] uppercase text-text-faint-dark light:text-text-faint-light mb-2">
            Email
          </label>
          <input
            type="email"
            name="email"
            required
            class="w-full bg-surface-dark light:bg-surface-light border border-border-dark light:border-border-light px-4 py-3 text-sm text-text-primary-dark light:text-text-primary-light focus:outline-none focus:border-accent transition-colors"
          />
        </div>

        <div>
          <label class="block font-mono text-[10px] tracking-[0.25em] uppercase text-text-faint-dark light:text-text-faint-light mb-2">
            {isEs ? "Mensaje" : "Message"}
          </label>
          <textarea
            name="message"
            rows={6}
            required
            class="w-full bg-surface-dark light:bg-surface-light border border-border-dark light:border-border-light px-4 py-3 text-sm text-text-primary-dark light:text-text-primary-light focus:outline-none focus:border-accent transition-colors resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="font-mono text-xs tracking-[0.20em] uppercase text-accent border border-accent px-8 py-3 hover:bg-accent hover:text-bg-dark transition-colors"
        >
          {isEs ? "Enviar" : "Send"}
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
